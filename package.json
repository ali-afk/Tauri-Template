{
	"name": "tauri-template",
	"version": "2.0.0",
	"private": true,
	"description": "Personal SvelteKit starter template with design tokens, auto-contrast colors, and component library",
	"license": "MPL-2.0",
	"workspaces": {
		"packages": [
			"packages/*"
		]
	},
	"type": "module",
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@vitest/coverage-istanbul": "catalog:",
		"@wdio/cli": "^9",
		"@wdio/junit-reporter": "^9",
		"@wdio/local-runner": "^9",
		"@wdio/mocha-framework": "^9",
		"@wdio/spec-reporter": "^9",
		"@wdio/tauri-service": "^1.5",
		"browserslist": "^4.29.3",
		"lefthook": "^2.1.17",
		"lightningcss": "^1.33.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"overrides": {
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2",
			"onFail": "download"
		}
	},
	"catalog": {
		"@vitest/coverage-istanbul": "5.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
		"vite-plus": "1.1.0",
		"vitest": "5.0.3"
	}
}
