{
	"name": "tauri-template",
	"private": true,
	"version": "1.6.1",
	"description": "Personal SvelteKit starter template with design tokens, auto-contrast colors, and component library",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"clean": "bun clean:assets && bun clean:build",
		"clean:assets": "rm -rf .svelte-kit tests/report.xml src-tauri/gen src/lib/styles/gen.css",
		"clean:build": "rm -rf build src-tauri/target",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"gen": "bun run scripts/gen/index.ts",
		"check": "bun check:biome && bun check:svelte && bun check:md",
		"check:md": "dprint fmt",
		"check:biome": "biome check --fix --no-errors-on-unmatched",
		"check:svelte": "svelte-kit sync && svelte-check-rs",
		"watch": "bun check:svelte --watch",
		"tauri:dev": "tauri dev",
		"tauri:build": "NO_STRIP=true tauri build",
		"test": "bun --bun vitest run",
		"test:watch": "bun --bun vitest",
		"test:coverage": "bun run test --coverage",
		"test:bench": "bun --bun bench",
		"wdio": "wdio run ./wdio.conf.ts",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@chromatic-com/storybook": "^5.2.1",
		"@dprint/markdown": "^0.22.1",
		"@storybook/addon-a11y": "^10.5.4",
		"@storybook/addon-docs": "^10.5.4",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/sveltekit": "^10.5.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/webdriverio": "^3.2.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"@vitejs/devtools": "^0.4.8",
		"@vitest/coverage-istanbul": "4.1.10",
		"@wdio/cli": "^9.30.0",
		"@wdio/globals": "^9.29.1",
		"@wdio/junit-reporter": "^9.29.1",
		"@wdio/local-runner": "^9.30.0",
		"@wdio/mocha-framework": "^9.30.0",
		"@wdio/spec-reporter": "^9.29.1",
		"@wdio/tauri-plugin": "^1.2.0",
		"@wdio/tauri-service": "^1.2.0",
		"bits-ui": "^2.18.1",
		"browserslist": "^4.28.7",
		"dprint": "^0.55.2",
		"expect-webdriverio": "^5.7.0",
		"happy-dom": "^20.11.1",
		"lefthook": "^2.1.10",
		"lightningcss": "^1.33.0",
		"open-props": "^1.7.23",
		"storybook": "^10.5.4",
		"svelte": "^5.56.7",
		"svelte-check-rs": "^0.11.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vite-devtools-svelte": "^0.3.0",
		"vite-plugin-run": "^0.9.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-log": "^2.9.0",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-store": "^2.4.4",
		"bezier-easing": "^3.0.1"
	},
	"trustedDependencies": [
		"dprint",
		"edgedriver",
		"esbuild",
		"geckodriver",
		"lefthook"
	]
}
